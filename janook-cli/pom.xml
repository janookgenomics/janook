<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.janookgenomics</groupId>
    <artifactId>janook-parent</artifactId>
    <version>9.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>janook-cli</artifactId>
  <packaging>jar</packaging>

  <name>janook-cli</name>
  <description>
    The janook command. Wraps janook-core and owns everything core refuses to do: reading YAML and
    TSV input, loading species profiles, formatting reports, exit codes. Fully offline.
  </description>

  <!--
    A plain jar with a main, run as java -jar janook-cli/target/janook-cli-<version>.jar.
    A launcher will wrap that later so users never type it. There is deliberately no framework
    runner here — the earliest a framework appears is janook-web in phase 4.
  -->

  <!--
    Fallbacks for the git properties, used verbatim when the build has no git history to read —
    a release tarball, a source zip, a Docker context that excludes .git. The plugin below
    overwrites both when a repository is present.

    Without these, filtering would leave the literal ${git.commit.id.abbrev} in the packaged
    resource, and the command would print that placeholder to somebody recording provenance.
  -->
  <properties>
    <git.commit.id.abbrev>unknown</git.commit.id.abbrev>
    <git.dirty>false</git.dirty>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.janookgenomics</groupId>
      <artifactId>janook-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!--
      Declaring <resources> here REPLACES the parent's block rather than adding to it, so the
      LICENSE and NOTICE entries are restated below. Dropping them would silently ship a jar that
      violates Apache-2.0 section 4, and nothing would fail to tell us.

      Two entries cover src/main/resources because filtering is per-directory, not per-file: the
      version properties file must be filtered, and everything else must not, because filtering a
      binary resource corrupts it.
    -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>janook-version.properties</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>janook-version.properties</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>..</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
          <include>NOTICE</include>
        </includes>
      </resource>
    </resources>

    <plugins>
      <!--
        Reads the commit and the dirty flag out of git, into project properties that resource
        filtering then writes into janook-version.properties.

        Bound to initialize: the properties must exist before process-resources, or filtering
        silently emits the fallbacks above and every jar claims an unknown commit.

        failOnNoGitDirectory is false on purpose. Bioconda builds from a release tarball, which has
        no .git, and so do source zips and Docker contexts that exclude it — failing those builds
        would make the tool unbuildable on its main distribution path to police a rule that only
        matters at release time. The release check enforces it where it belongs: no commit, or a
        dirty tree, means no release. See docs/VERSIONING.md.
      -->
      <plugin>
        <groupId>io.github.git-commit-id</groupId>
        <artifactId>git-commit-id-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>capture-build-commit</id>
            <phase>initialize</phase>
            <goals>
              <goal>revision</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <!--
            Shell out to git rather than use the plugin's bundled JGit. Not a preference: JGit
            prints a stack trace after BUILD SUCCESS on macOS, and this setting makes the dirty
            flag mean what git status means. The three build environments this was verified
            against, and what each one costs, are in docs/DECISIONS.md.
          -->
          <useNativeGit>true</useNativeGit>
          <!-- The repository root: this module sits one level below it. -->
          <dotGitDirectory>${project.parent.basedir}/.git</dotGitDirectory>
          <failOnNoGitDirectory>false</failOnNoGitDirectory>
          <failOnUnableToExtractRepoInfo>false</failOnUnableToExtractRepoInfo>
          <!-- Filtering consumes the properties directly; a second generated file would be a
               second source of truth. -->
          <generateGitPropertiesFile>false</generateGitPropertiesFile>
          <abbrevLength>7</abbrevLength>
          <includeOnlyProperties>
            <includeOnlyProperty>^git.commit.id.abbrev$</includeOnlyProperty>
            <includeOnlyProperty>^git.dirty$</includeOnlyProperty>
          </includeOnlyProperties>
        </configuration>
      </plugin>

      <!--
        The main class, so the jar is runnable as java -jar rather than only from a classpath the
        user has to assemble. A launcher will wrap this later; the manifest is what it wraps.

        Class-Path alongside it: without it the build passes and the jar throws
        NoClassDefFoundError, because tests run on the reactor classpath and java -jar does not.
        See docs/DECISIONS.md.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.janookgenomics.janook.cli.Janook</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <!--
        Puts the runtime dependencies where that Class-Path says they are. A jar plus a lib
        directory, not a single shaded artifact — see docs/DECISIONS.md.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>runtime-dependencies-beside-the-jar</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
