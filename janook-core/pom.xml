<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.janookgenomics</groupId>
    <artifactId>janook-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>janook-core</artifactId>
  <packaging>jar</packaging>

  <name>janook-core</name>
  <description>
    The AVCG criteria, their weights and the decision tree. Pure Java: no framework, no I/O, no
    species knowledge. Evidence in, classification out.
  </description>

  <!--
    NO COMPILE-SCOPE THIRD-PARTY DEPENDENCIES. This is a hard rule, and it is load-bearing: it is
    what makes janook-core embeddable in someone else's pipeline without dragging in a persistence
    layer, a web server or a CLI framework.

    The pressure arrives with the criterion definitions, which have to be read from somewhere. Both
    acceptable resolutions keep this file empty of third-party compile dependencies — parse in
    janook-cli and hand core a built object, or generate core's criterion table at build time. A
    later change turns this comment into something the build enforces.
  -->

</project>
